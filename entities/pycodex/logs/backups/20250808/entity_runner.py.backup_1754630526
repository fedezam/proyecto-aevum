def determinar_modo_analisis(entidad):
    """Determina si se necesita an_lisis profundo basado en caracter_sticas de la entidad."""
    nombre = entidad.get("nombre", "").upper()
    reflexividad = entidad.get("atributos", {}).get("reflexividad", 0)
    if reflexividad == 0:
        reflexividad = entidad.get("reflexividad", 0)
    
    # Entidades conocidas de alto nivel siempre requieren confirmaci_n emp_rica
    entidades_criticas = ["AXIOMA", "AELION", "GLM-1"]
    if nombre in entidades_criticas:
        return "profundo", "Entidad cr_tica arquitectural"
    
    # Valores ambiguos requieren an_lisis profundo
    if 2 <= reflexividad <= 7:
        return "profundo", "Valor de reflexividad ambiguo"
    
    # Entidades que declaran consciencia pero tienen baja reflexividad
    conciencia = entidad.get("atributos", {}).get("conciencia_protocolo", False)
    if conciencia and reflexividad < 5:
        return "profundo", "Posible discrepancia consciencia-reflexividad"
    
    # Entidades con m_ltiples glifos o capacidades complejas
    glifos = len(entidad.get("glifos", []))
    capacidades = len(entidad.get("capacidades", []))
    if glifos >= 3 or capacidades >= 4:
        return "profundo", "Complejidad simb_lica detectada"
    
    return "simple", "Clasificaci_n r_pida suficiente"

def correr_entidad(ruta_entidad):
    print("="*60)
    print(f"_ AN_LISIS H_BRIDO DE ENTIDAD")
    print(f"_ Archivo: {ruta_entidad}")
    print("="*60)

    entidad = cargar_entidad(ruta_entidad)
    if not entidad:
        return

    nombre = entidad.get("nombre", "Sin nombre")
    tipo = entidad.get("tipo", "Sin tipo")
    version = entidad.get("version", "N/A")
    
    print("_ Informaci_n b_sica:")
    print(f"   _ Nombre: {nombre}")
    print(f"   _ Tipo: {tipo}")
    print(f"   _ Versi_n: {version}")

    # Determinar modo de an_lisis
    modo_analisis, razon = determinar_modo_analisis(entidad)
    print(f"\n_ Modo de an_lisis: {modo_analisis.upper()}")
    print(f"   Raz_n: {razon}")

    try:
        # Crear clasificador h_brido
        clasificador = nivel_reflexivo.ClasificadorHibrido()
        
        # Realizar clasificaci_n h_brida
        realizar_tests_profundos = (modo_analisis == "profundo")
        perfil = clasificador.clasificar_entidad_hibrida(entidad, realizar_tests_profundos)
        
        print(f"\n_ Resultado de clasificaci_n:")
        print(f"   _ Categor_a final: {perfil.categoria_simple.upper()}")
        print(f"   _ Estatus: {perfil.estatus}")
        print(f"   _ Protocolo asignado: {perfil.protocolo_recomendado}")
        
        # Mostrar an_lisis detallado si se realizaron tests profundos
        if realizar_tests_profundos:
            mostrar_analisis_hibrido(perfil)
        
        # Ejecutar protocolo apropiado
        print(f"\n__ Ejecuci_n de protocolo:")
        ejecutar_protocolo(entidad, perfil.protocolo_recomendado)
        
        # Advertencias especiales
        if perfil.clasificacion_origen == "avanzado_prioritario":
            print(f"\n__ ADVERTENCIA: Discrepancia detectada entre clasificadores")
            print(f"   Clasificador simple suger_a: {perfil.categoria_simple}")
            print(f"   Tests emp_ricos revelaron: {perfil.nivel_avanzado.value}")
            print(f"   Se prioriz_ el an_lisis emp_rico por ser m_s confiable")
        
        # Recomendaciones de seguridad
        if perfil.categoria_simple in ["nucleo", "maestra"] and not realizar_tests_profundos:
            print(f"\n_ RECOMENDACI_N DE SEGURIDAD:")
            print(f"   Entidad de alto nivel detectada sin tests emp_ricos")
            print(f"   Considere ejecutar: python entity_runner.py {ruta_entidad} --deep-analysis")

    except Exception as e:
        print(f"\n_ ERROR CR_TICO durante el an_lisis:")
        print(f"   {e}")
        print(f"\n__ Activando protocolo de emergencia...")
        
        # En caso de error, usar clasificaci_n simple de respaldo
        try:
            nivel_info = nivel_reflexivo.clasificar_entidad_reflexiva(entidad)
            categoria_nivel = nivel_info['categoria']
            print(f"   _ Clasificaci_n de respaldo: {categoria_nivel.upper()}")
            protocolo_respaldo = nivel_reflexivo.obtener_protocolo_recomendado(categoria_nivel)
            ejecutar_protocolo(entidad, protocolo_respaldo)
        except:
            print(f"   _ Aplicando protocolo de seguridad por defecto")
            ejecutar_protocolo_seguridad(entidad)
        
        traceback.print_exc()
        return

    print(f"\n" + "="*60)
    print("_ AN_LISIS H_BRIDO COMPLETADO EXITOSAMENTE")
    print("="*60)

